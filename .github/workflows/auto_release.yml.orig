name: ArcPDF Auto Release

on:
  push:
    branches:
      - main

  workflow_dispatch:
    inputs:
      version:
        description: 'Release version (e.g. v1.0.3). Leave empty to use pubspec.yaml version.'
        required: false
        default: ''

permissions:
  contents: write

jobs:
  versioning-and-build:
    name: Build Android and Manage Version
    runs-on: ubuntu-latest
    outputs:
      release_version: ${{ steps.set_output.outputs.version }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'

      - name: Install dependencies
        run: flutter pub get

      - name: Extract current version
        id: get_version
        env:
          INPUT_VERSION: ${{ github.event.inputs.version }}
        run: |
          VERSION=$(grep '^version: ' pubspec.yaml | awk '{print $2}' | tr -d '\r')
          echo "Current pubspec version: $VERSION"
          if [ -n "$INPUT_VERSION" ]; then
            CLEAN_VERSION=$(echo "$INPUT_VERSION" | sed 's/^v//' | tr -d '\r')
            echo "Using manual version: $CLEAN_VERSION"
            echo "VERSION=$CLEAN_VERSION" >> $GITHUB_ENV
          else
            echo "VERSION=$VERSION" >> $GITHUB_ENV
          fi

      - name: Set Version Output
        id: set_output
        run: echo "version=${{ env.VERSION }}" >> $GITHUB_OUTPUT

      - name: Check if tag exists
        id: check_tag
        run: |
          if git ls-remote --tags origin | grep -q "refs/tags/v${{ env.VERSION }}"; then
            echo "Tag v${{ env.VERSION }} already exists. Skipping release."
            echo "SKIP_RELEASE=true" >> $GITHUB_ENV
          else
            echo "SKIP_RELEASE=false" >> $GITHUB_ENV
          fi

      - name: Build Split APKs
        if: env.SKIP_RELEASE == 'false'
        run: flutter build apk --release --split-per-abi --obfuscate --split-debug-info=build/app/outputs/symbols

      - name: Build AppBundle
        if: env.SKIP_RELEASE == 'false'
        run: flutter build appbundle --release --obfuscate --split-debug-info=build/app/outputs/symbols

      - name: Rename & Organize Artifacts
        if: env.SKIP_RELEASE == 'false'
        run: |
          mkdir -p release

          if [ -f build/app/outputs/flutter-apk/app-release.apk ]; then
            cp build/app/outputs/flutter-apk/app-release.apk "release/ArcPDF-v${{ env.VERSION }}-universal.apk"
          fi

          cp build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk "release/ArcPDF-v${{ env.VERSION }}-armeabi-v7a.apk" || true
          cp build/app/outputs/flutter-apk/app-arm64-v8a-release.apk "release/ArcPDF-v${{ env.VERSION }}-arm64-v8a.apk" || true
          cp build/app/outputs/flutter-apk/app-x86_64-release.apk "release/ArcPDF-v${{ env.VERSION }}-x86_64.apk" || true

          cp build/app/outputs/bundle/release/app-release.aab "release/ArcPDF-v${{ env.VERSION }}.aab" || true

      - name: Upload Artifacts
        if: env.SKIP_RELEASE == 'false'
        uses: actions/upload-artifact@v4
        with:
          name: android-artifacts
          path: release/*

      - name: Create Git Tag (Pre-Bump)
        if: env.SKIP_RELEASE == 'false'
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git tag "v${{ env.VERSION }}"
          git push origin "v${{ env.VERSION }}"

      - name: Bump Version in pubspec.yaml
        if: env.SKIP_RELEASE == 'false' && github.event_name == 'push'
        run: |
          dart pub global activate cider
          export PATH="$PATH":"$HOME/.pub-cache/bin"
          cider bump build
          NEW_VERSION=$(cider version)
          echo "New bumped version: $NEW_VERSION"
          echo "NEW_VERSION=$NEW_VERSION" >> $GITHUB_ENV

      - name: Commit and Push Bumped Version
        if: env.SKIP_RELEASE == 'false' && github.event_name == 'push'
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add pubspec.yaml
          git commit -m "chore: bump version to ${{ env.NEW_VERSION }} [skip ci]"
          git push origin main

  release:
    name: Create GitHub Release
    needs: [versioning-and-build]
    if: success() && needs.versioning-and-build.outputs.release_version != ''
    runs-on: ubuntu-latest

    steps:
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          name: android-artifacts
          path: artifacts
          merge-multiple: true

      - name: Check for Artifacts
        id: check_artifacts
        run: |
          if [ ! -d "artifacts" ] || [ -z "$(ls -A artifacts)" ]; then
             echo "No artifacts found. Skipping release creation."
             echo "skip=true" >> $GITHUB_ENV
          else
             echo "skip=false" >> $GITHUB_ENV
          fi

      - name: Create ArcPDF Release
        if: env.skip == 'false'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ needs.versioning-and-build.outputs.release_version }}
          name: ArcPDF v${{ needs.versioning-and-build.outputs.release_version }}
          files: "artifacts/*"
          generate_release_notes: true
          overwrite_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
